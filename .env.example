# 64 hex chars. Encrypts the stored Clubhouse session token. start.ps1 generates one on first run.
# Moving a session from another install? Use that install's key, or the token will not decrypt.
KMS_MASTER_KEY=

# Only needed if you log in by SMS instead of importing from Clubdeck: the Agora App ID that
# Clubhouse's audio runs on (Clubdeck's profile.json carries it as `agoraKey`).
CLUBHOUSE_AGORA_APP_ID=

# Optional: a host app that implements the bridge endpoints (docs/HOW_IT_WORKS.md §5).
# Leave empty to run StudioCall on its own.
STUDIOMATE_URL=

# Defaults
# STUDIOCALL_PORT=4019
# STUDIOCALL_DATA_DIR=data
# STUDIOCALL_AUDIO_URL=http://127.0.0.1:4018
# STUDIOCALL_LEAVE_ON_ADMIN_CLOSE=1
# SC_CERT_DIR=               (mkcert folder, for the https dev server)
